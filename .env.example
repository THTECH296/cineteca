# Supabase — crie um projeto grátis em https://supabase.com (Project Settings → API)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-publishable-key

# A chave do AbacatePay NÃO vai aqui — ela fica como secret da Edge Function:
#   supabase secrets set ABACATEPAY_KEY=abc_dev_xxx --project-ref <ref>
